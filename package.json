{
  "name": "stock-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:check": "tsx scripts/check-local-dev.ts",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrate-to-turso": "tsx scripts/migrate-local-to-turso.ts",
    "batch:update-latest": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/update-latest.ts",
    "batch:ohlcv": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ohlcv.ts",
    "batch:ohlcv:fetch-only": "USE_LOCAL_DB=1 POST_OHLCV_REFRESH=0 tsx --env-file=.env.local scripts/batch-ohlcv.ts",
    "batch:post-ohlcv-refresh": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/refresh-after-ohlcv.ts",
    "batch:snapshots": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-snapshots.ts",
    "batch:features": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-features.ts",
    "batch:forward-returns": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-forward-returns.ts",
    "batch:forward-returns:ml": "USE_LOCAL_DB=1 FORWARD_RETURN_HORIZONS=20,40,60,90 tsx --env-file=.env.local scripts/batch-forward-returns.ts",
    "batch:forward-returns:short": "USE_LOCAL_DB=1 FORWARD_RETURN_HORIZONS=2,3,4,5,10,15 tsx --env-file=.env.local scripts/batch-forward-returns.ts",
    "batch:pattern-stats": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-pattern-stats.ts",
    "batch:pattern-stats:short": "USE_LOCAL_DB=1 PATTERN_STAT_HORIZONS=2,3,4,5,10,15 tsx --env-file=.env.local scripts/batch-pattern-stats.ts",
    "batch:stage-transitions": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-stage-transitions.ts",
    "batch:listed-info": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-listed-info.ts",
    "batch:shares-outstanding": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-shares-outstanding.ts",
    "batch:credit-short": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-credit-short.ts",
    "batch:margin-serving": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/build-serving-margin.ts",
    "batch:earnings": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-earnings.ts",
    "batch:earnings-history": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-earnings-history.ts",
    "batch:earnings-refresh": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/refresh-earnings.ts",
    "batch:indices": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-indices.ts",
    "batch:dashboard-cache": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/build-dashboard-cache.ts",
    "batch:weekly-ohlcv": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-weekly-ohlcv.ts",
    "batch:forward-extrema": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-forward-extrema.ts",
    "batch:forward-extrema:ml-full": "USE_LOCAL_DB=1 BACKTEST_RECENT_DAYS=0 FORWARD_EXTREMA_START_DATE=2008-01-01 FORWARD_EXTREMA_HORIZONS=20,40,60,90 FORWARD_EXTREMA_WRITE_MODEL_LABELS=0 tsx --env-file=.env.local scripts/batch-forward-extrema.ts",
    "batch:technical-signals": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-technical-signals.ts",
    "batch:signal-stats": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-signal-stats.ts",
    "batch:signal-return-stats": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-signal-return-stats.ts",
    "batch:serving-backtest": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/build-serving-backtest.ts",
    "batch:serving-stock": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/build-serving-stock.ts",
    "batch:ml-features": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ml-features.ts",
    "batch:ml-labels": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ml-labels.ts",
    "batch:ml-train": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ml-train.ts",
    "batch:ml-predict": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ml-predict.ts",
    "batch:ml-outcomes": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ml-outcomes.ts",
    "batch:ml-evaluate": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ml-evaluate.ts",
    "batch:ml-candidates": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/batch-ml-candidates.ts",
    "batch:ml-insights": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/build-serving-ml-insights.ts",
    "batch:ml-daily": "ML_RECENT_DAYS=260 ML_MIN_HISTORY_DAYS=200 npm run batch:ml-features && npm run batch:ml-labels && npm run batch:ml-outcomes && npm run batch:ml-train && npm run batch:ml-candidates && npm run batch:ml-predict && npm run batch:ml-insights",
    "batch:ml-weekly-train": "npm run batch:forward-returns:ml && ML_TRAIN_START_DATE=2008-05-07 ML_TRAIN_SAMPLE_MODE=yearly ML_TRAIN_LABEL_SOURCE=extrema npm run batch:ml-train && npm run batch:ml-candidates && npm run batch:ml-predict && npm run batch:ml-insights && npm run batch:ml-evaluate",
    "batch:ml-full": "npm run batch:forward-returns:ml && ML_RECENT_DAYS=0 ML_MIN_HISTORY_DAYS=1 ML_START_DATE=2008-05-07 npm run batch:ml-features && npm run batch:ml-labels && ML_TRAIN_START_DATE=2008-05-07 ML_TRAIN_SAMPLE_MODE=yearly ML_TRAIN_LABEL_SOURCE=extrema npm run batch:ml-train && npm run batch:ml-candidates && npm run batch:ml-predict && npm run batch:ml-insights",
    "batch:signal-stats:full": "USE_LOCAL_DB=1 BACKTEST_RECENT_DAYS=0 SIGNAL_STATS_LIMIT_GROUPS=0 SIGNAL_STATS_DATE_CHUNK=20 tsx --env-file=.env.local scripts/batch-signal-stats.ts",
    "batch:serving-backtest:full": "USE_LOCAL_DB=1 SERVING_DATE_LIMIT=0 SERVING_SUMMARY_DATE_CHUNK=40 tsx --env-file=.env.local scripts/build-serving-backtest.ts",
    "batch:backtest-foundation": "npm run batch:weekly-ohlcv && npm run batch:forward-extrema && npm run batch:technical-signals && npm run batch:signal-stats && npm run batch:signal-return-stats && npm run batch:serving-backtest && npm run batch:serving-stock && npm run batch:ml-features && npm run batch:ml-train && npm run batch:ml-candidates && npm run batch:ml-insights",
    "batch:backtest-full": "npm run batch:signal-stats:full && npm run batch:serving-backtest:full && npm run batch:serving-stock && npm run batch:ml-full",
    "import:classification": "USE_LOCAL_DB=1 tsx --env-file=.env.local scripts/import-classification.ts",
    "sync:turso:optimized": "tsx --env-file=.env.local scripts/sync-optimized-to-turso.ts",
    "verify:phase3": "tsx --env-file=.env.local scripts/verify-phase3.ts",
    "pull": "git pull origin claude/resume-development-kvnU1",
    "sync": "git pull origin claude/resume-development-kvnU1 && npm install"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-popover": "^1.1.15",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3": "^7.9.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
