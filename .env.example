# StockBoard 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、各値を実値に置き換える。
# .env.local は .gitignore 済み (リポジトリに上がらない)。

# ─── J-Quants API (Phase 3.5 以降の唯一のデータソース) ───
# Premium プラン契約のダッシュボードで発行する API キー。
# v2 仕様、有効期限なし (再発行可能)。
JQUANTS_API_KEY=your_jquants_api_key
EDINET_API_KEY=your_edinet_api_key

# ─── Turso (libSQL クラウド DB) ───
# 既存の web app (capital-flow / screener など) が読む既存テーブル用。
# 新しい Phase 2 以降のテーブル (ohlcv_daily / daily_snapshots / feature_snapshots
# / forward_returns / pattern_stats / stage_transitions) はローカル SQLite を使う。
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ─── ローカル SQLite を使う ───
# MacBook/Mac mini の開発では file:./data/stockboard.db を使う。
USE_LOCAL_DB=1
# 外部SSDなどにローカルSQLiteを置く場合だけ指定。
# 例: STOCKBOARD_DB_PATH=/Volumes/OWC Express 1M2 80G/stock-dashboard/stockboard.db
STOCKBOARD_DB_PATH=

# ─── OpenAI / StockBoard AI Assistant (optional) ───
# .env.local にだけ実値を入れる。キーはクライアントへ渡さず、サーバー側 API だけが読む。
# 未設定でも「AIに探してもらう」はローカル判定フォールバックで動作する。
OPENAI_API_KEY=your_openai_api_key
# 0 にするとキーがあってもOpenAIを呼ばず、ローカル判定フォールバックに固定する。
OPENAI_ASSISTANT_ENABLED=1
# 自然言語ルーター用途は低遅延・低コスト寄りのモデルを初期値にする。
# より複雑な指示理解を重視する場合は gpt-5.5 などへ変更する。
OPENAI_ASSISTANT_MODEL=gpt-5.4-mini
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini

# ─── ML / reinforcement learning cadence (optional) ───
# 日次更新では直近範囲で軽量再学習、週次では2008年以降の広い再学習/検証を行う。
ML_SHORT_DAILY_WRITE_RL_STATES=1
ML_RL_RECENT_DAYS=520
ML_PHYSICS_DAILY_EVALUATE=0

# ─── 知人共有 / Cloudflare Tunnel 用 (optional) ───
# 1 にすると全ページ/APIへ Basic 認証を要求する。
STOCKBOARD_SHARE_MODE=0
# 共有用のユーザー名とパスワード。実値は .env.local のみに書く。
STOCKBOARD_SHARE_BASIC_USER=friend
STOCKBOARD_SHARE_BASIC_PASSWORD=change-this-long-password
# 共有時は原則読み取り専用。AIチャットや保存系POSTも許可したい場合だけ 0 にする。
STOCKBOARD_SHARE_READ_ONLY=1
# 共有時は /admin と /api/admin を原則ブロックする。特別な理由がある場合だけ 1。
STOCKBOARD_SHARE_ALLOW_ADMIN=0
